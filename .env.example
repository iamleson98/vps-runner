# ============================================================================
# vps-runner controller configuration
# Normally this file is RENDERED AUTOMATICALLY on the VPS by the Deploy
# GitHub workflow (scripts/ci_deploy.sh) from repo secrets + variables.
# Only edit it by hand if you deploy locally with `make deploy`.
# ============================================================================

# --- GitHub auth -------------------------------------------------------------

# Classic PAT with `repo` scope (or `public_repo` for public repos only).
# Fine-grained PATs also work: "Self-hosted runners: RW", "Actions: R",
# "Metadata: R" on every allow-listed repository.
GITHUB_PAT=

# --- Allow-list (the only repos this VPS will ever run jobs for) ---------------

# Comma-separated owner/repo list. Hard enforcement point:
#   * only these repos are polled for queued jobs
#   * JIT runners are registered inside these repos only
GITHUB_REPOSITORIES=your-github-username/your-repo

# --- Runner pool ----------------------------------------------------------------

# Labels assigned to every runner. Match your workflows:
#   runs-on: [self-hosted, vps]
RUNNER_LABELS=vps

# Only queued jobs carrying at least one of these labels are counted for
# scaling decisions (comma separated).
MATCH_LABELS=vps

# Pool size. Sizing guide for common OVH VPS plans (2026/2027 ranges):
#   VPS-1 (2 vCores /  4 GB) -> MIN=0 MAX=1 RUNNER_MEMORY_GB=2
#   VPS-2 (4 vCores /  8 GB) -> MIN=0 MAX=2 RUNNER_MEMORY_GB=3
#   VPS-3 (6 vCores / 12 GB) -> MIN=0 MAX=3 RUNNER_MEMORY_GB=3.5
#   VPS-4 (8 vCores / 24 GB) -> MIN=0 MAX=4 RUNNER_MEMORY_GB=5
# (docker --memory is a cap, not a reservation - slight overcommit is fine)
MIN_RUNNERS=0
MAX_RUNNERS=2
RUNNER_MEMORY_GB=2.5

# Per-runner CPU cap (docker --cpus). Empty = uncapped (jobs share the VPS).
RUNNER_CPUS=

# Runner image (built by deploy/install.sh).
RUNNER_IMAGE=vps-runner/runner:latest

# Let jobs use `docker build` / `docker run` through the host docker daemon
# (sibling containers). Disable if you do not need docker-in-CI.
MOUNT_DOCKER_SOCK=true

CONTAINER_PREFIX=gha-runner

# --- Behaviour -----------------------------------------------------------------------

POLL_INTERVAL=15          # seconds between queue polls
HOUSEKEEP_INTERVAL=300    # seconds between housekeeping sweeps
PRUNE_INTERVAL=21600      # seconds between docker prunes (6 h)

# --- Status page ---------------------------------------------------------------------

# The compose file publishes 127.0.0.1:8080 only. Reach it via SSH tunnel:
#   ssh -N -L 8080:localhost:8080 <user>@<vps-ip>
STATUS_BIND=0.0.0.0
STATUS_PORT=8080

# Optional shared secret; then requests need ?token=... or X-Status-Token.
STATUS_TOKEN=
